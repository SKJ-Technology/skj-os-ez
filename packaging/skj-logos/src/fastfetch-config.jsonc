// SKJ OS EZ ISO Edition - system-wide fastfetch defaults.
// Copy to ~/.config/fastfetch/config.jsonc to customise it for your user.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/skj/fastfetch/logo.txt",
    "color": {
      "1": "38;2;37;99;235",
      "2": "38;2;20;184;166"
    },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "38;2;20;184;166" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "theme",
    "icons",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "locale",
    "break",
    "colors"
  ]
}
